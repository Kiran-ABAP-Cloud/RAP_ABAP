projection;
strict ( 2 );
use side effects;

define behavior for ZRAP_KK_TRAVEL_PROCESSOR alias Travel
{
  use create;
  use update;
  use delete;

  use action copyTravel;

  use association _Booking { create; }
}

define behavior for ZRAP_KK_BOOKING_PROCESSOR alias Booking
{
  use update;
  use delete;

  use association _Travel;
  use association _BookingSuppl { create; }
}

define behavior for ZRAP_KK_BOOKSUPPL_PROCESSOR alias BookSuppl
{
  use update;
  use delete;

  use association _Travel;
  use association _Booking;
}