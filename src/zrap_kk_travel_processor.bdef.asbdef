projection;
strict ( 2 );
use side effects;
use draft;

define behavior for ZRAP_KK_TRAVEL_PROCESSOR alias Travel
{
  use create;
  use update;
  use delete;

  use action activate;
  use action edit;
  use action resume;
  use action prepare;
  use action discard;

  use action copyTravel;

  use association _Booking { create; with draft;}
}

define behavior for ZRAP_KK_BOOKING_PROCESSOR alias Booking
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _BookingSuppl { create; with draft;}
}

define behavior for ZRAP_KK_BOOKSUPPL_PROCESSOR alias BookSuppl
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _Booking { with draft; }
}