//mnaged will tell RAP that developer want RAP to create most of code automatically
managed;
//In case developer want to plug extra coding, this is the class where we can do it

//Tell the RAP engine to syntax check our code strictly
strict ( 2 );
//Root entity behaviour
define behavior for ZRAP_KK_TRAVEL alias Travel
implementation in class zbp_rap_kk_travel unique
//Tell the RAP that it should WRITE, UPDATE,MODIFY,DELETE data from which table
persistent table /dmo/travel_m
//How the data will be locked ENQUEUE, DEQUEUE - if the travel data is locked by user, other
//users parallelly cannot edit its bookings and supplements
lock master
//To Control data security - permission - authorization of who can create, edit, delete data
//ToDO: Developer must implement coding for this line in class
authorization master ( instance )
//eTag is a concurrency control which controls the behaviour of multiple users simultaneously editing data
etag master LastChangedAt
//We want as a developer to take control of Travel ID
early numbering
{
  //Behaviour what we want RAP to generate for us
  create;
  update;
  delete;
  //static feature control which says that a user cannot change primary key in update mode
  field ( readonly ) TravelId;
  field ( mandatory ) begindate, enddate, agencyid, customerid;
  //since we want to create new BO instance (Facotry), our reference if Mohan's(instance)
  //create the code logic in behaviour implementation, add this action in Travel processor Behaviour definition to expose,
  //and finally add the button 'Copy Request' for TravelId in the Travel Processor MDE file
  factory action copyTravel[1];
  //Here we write internal action to calculate total cost of travel
  //we can later consume this internal action multiple places
  internal action recCalcTotalPrice;

  //Determination that calls when user save, modify booking fee
  determination CalcTotalPrice on modify { field BookingFee, CurrencyCode; create; }

  //That create of booking depends on Travel, like you cannot create a SO line item w/o creating header
  //Dynamic feature control - features:instance
  association _Booking { create ( features : instance ); }
  //mapping is required as CDS projection entity and actual DB table fields are different and they
  //won't be created the entry in DB table without this by RAP engine
  mapping for /dmo/travel_m
    {
      TravelId      = travel_id;
      BeginDate     = begin_date;
      EndDate       = end_date;
      AgencyId      = agency_id;
      CustomerId    = customer_id;
      CurrencyCode  = currency_code;
      TotalPrice    = total_price;
      BookingFee    = booking_fee;
      LastChangedAt = last_changed_at;
      LastChangedBy = last_changed_by;
      CreatedBy     = created_by;
      CreatedAt     = created_at;
      Description   = description;
      OverallStatus = overall_status;
    }
}

//Behaviour for Booking entity
define behavior for ZRAP_KK_BOOKING alias Booking
implementation in class zbp_rap_kk_booking unique
persistent table /dmo/booking_m
//if parent data is locked child is also locked automatically
lock dependent by _Travel
//lets check the authorization and role @ parent if that pass, we allo booking also to be updated
authorization dependent by _Travel
etag master LastChangedAt
//Support for automatic creation of early numbering for Bookings
early numbering
{
  //User is allowed to only change and delete booking independently
  update;
  delete;
  //While user is editing the booking data, they cannot change the travel header data
  field ( readonly ) TravelId, BookingId;
  field ( mandatory ) CarrierId, ConnectionId, BookingDate, customerid;
  association _Travel;
  //Supplement creation is possible with booking
  association _BookingSuppl { create; }

  //Determination that calls when user save, modify flight price
  determination CalcTotalPriceBook on modify { field FlightPrice, CurrencyCode; create; }

  mapping for /dmo/booking_m
    {
      TravelId      = travel_id;
      BookingId     = booking_id;
      BookingDate   = booking_date;
      BookingStatus = booking_status;
      CarrierId     = carrier_id;
      ConnectionId  = connection_id;
      FlightDate    = flight_date;
      FlightPrice   = flight_price;
      CurrencyCode  = currency_code;
      CustomerId    = customer_id;
      LastChangedAt = last_changed_at;
    }
}
//Behaviour for BookSuppl entity
define behavior for ZRAP_KK_BOOKSUPPL alias BookSuppl
implementation in class zbp_rap_kk_booksuppl unique
persistent table /dmo/booksuppl_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
early numbering
{
  update;
  delete;
  field ( readonly ) TravelId, BookingId, BookingSupplementId;
  field ( mandatory ) SupplementId, CurrencyCode, price;
  association _Travel;
  association _Booking;

//Determination that calls when user save, modify price
  determination CalcTotalPriceSuppl on modify { field Price, CurrencyCode; create; }

  mapping for /dmo/booksuppl_m
    {
      TravelId            = travel_id;
      BookingId           = booking_id;
      BookingSupplementId = booking_supplement_id;
      SupplementId        = supplement_id;
      Price               = price;
      CurrencyCode        = currency_code;
      LastChangedAt       = last_changed_at;
    }
}