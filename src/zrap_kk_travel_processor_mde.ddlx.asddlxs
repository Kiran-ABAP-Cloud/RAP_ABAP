@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
    typeName: 'Travel Request',
    typeNamePlural: 'Travel Requests',
    title: { value: 'TravelId' },
    description: { value: 'Description' }
}
annotate entity ZRAP_KK_TRAVEL_PROCESSOR with
{
  @UI.facet: [{
      purpose:#HEADER,
      id: 'TravelHeaderPrice',
      type: #DATAPOINT_REFERENCE,
      position: 10,
      targetQualifier: 'optimusprime'
  },
  {
      purpose:#HEADER,
      id: 'TravelStatus',
      type: #DATAPOINT_REFERENCE,
      position: 20,
      targetQualifier: 'bumbblebee'
  },
  //Facet for item detail info on overview page and wrapped in a collection
  {
       purpose: #STANDARD,
       type:  #COLLECTION,
       id: 'idGeneralInfo',
       position: 10,
       label: 'General Information'
  },
  //First default identification tab with in item detail
  {
        purpose: #STANDARD,
        type: #IDENTIFICATION_REFERENCE,
        id: 'basic',
        label: 'Basic Data',
        parentId: 'idGeneralInfo',
        position: 10
  },
  //second tab onwards i.e fieldgroup with in item detail
  {
        purpose: #STANDARD,
        type: #FIELDGROUP_REFERENCE,
        id: 'dates',
        label: 'Travel Dates',
        parentId: 'idGeneralInfo',
        position: 20,
        targetQualifier: 'spiderman'
  },
  //Third tab onwards i.e fieldgroup with in item detail
  {
        purpose: #STANDARD,
        type: #FIELDGROUP_REFERENCE,
        id: 'prices',
        label: 'Costs',
        parentId: 'idGeneralInfo',
        position: 30,
        targetQualifier: 'wonderwomen'
  },
  //Next tab in the tabstrip wrapping in a second collection with line item with booking data
  { 
       purpose: #STANDARD,
       type:  #LINEITEM_REFERENCE,
       id: 'idItems',
       position: 20,
       label: 'Bookings',
       targetElement: '_Booking'
  }  
  ]
  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem: [{ position: 10  }]
  //field in the identification default tab in collection
  @UI.identification: [{ position: 10 }]
  TravelId;
  @UI.selectionField: [{ position: 20 }]
  @UI.lineItem: [{ position: 20  }]
  @UI.identification: [{ position: 30 }]
  AgencyId;
  @UI.selectionField: [{ position: 30 }]
  @UI.lineItem: [{ position: 30  }]
  @UI.identification: [{ position: 40 }]
  CustomerId;
  @UI.lineItem: [{ position: 40  }]
  //field in the 2nd tab onwards in collection
  @UI.fieldGroup: [{ position: 10, qualifier: 'spiderman' }]
  BeginDate;
  @UI.fieldGroup: [{ position: 20, qualifier: 'spiderman' }]
  EndDate;
  @UI.fieldGroup: [{ position: 10, qualifier: 'wonderwomen' }]
  BookingFee;
  @UI.selectionField: [{ position: 40 }]
  @UI.lineItem: [{ position: 50  }]
  @UI.dataPoint: { qualifier: 'optimusprime', title: 'Total Price' }
  @UI.fieldGroup: [{ position: 20, qualifier: 'wonderwomen' }]
  TotalPrice;
  @UI.fieldGroup: [{ position: 30, qualifier: 'wonderwomen' }]
  CurrencyCode;
  @UI.identification: [{ position: 20 }]
  Description;
  @UI.selectionField: [{ position: 50 }]
  //importance will bring the column to display for sure even if you render on mobile or small tablet
  @UI.lineItem: [{ position: 60,importance: #HIGH,criticality: 'Minion' }]
  @UI.dataPoint: { qualifier: 'bumbblebee', title: 'Travel Status', criticality: 'Minion' }
  @UI.fieldGroup: [{ position: 30, qualifier: 'spiderman' }]
  OverallStatus;
  //    CreatedBy;
  //    CreatedAt;
  //    LastChangedBy;
  //    LastChangedAt;


}