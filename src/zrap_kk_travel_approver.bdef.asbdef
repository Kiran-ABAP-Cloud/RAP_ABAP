projection;
strict ( 2 );
use collaborative draft;

define behavior for ZRAP_KK_TRAVEL_APPROVER alias Travel
{
//Modified the projection to allow things that are required only for the approver(for travel request)
  use update;
  field (readonly) agencyid, customerid, begindate, enddate, totalprice;

  use action acceptTravel;
  use action rejectTravel;

  use action Prepare;
  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Share;

  use association _Booking;
}

define behavior for ZRAP_KK_BOOKING_APPROVER alias Booking
{
  use association _Travel { with draft; }
}